# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=<fill in your database name>
POSTGRES_USER=<fill in your database user>
POSTGRES_PASSWORD=<fill in your database password>

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# Embedding: BGE-M3, local host
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu 
# EMBEDDING_DEVICE=cuda

# Cohere Rerank
COHERE_API_KEY=<fill in your Cohere API key>
COHERE_RERANK_MODEL=rerank-v3.5

# Gemini
GEMINI_API_KEY=<fill in your Gemini API key>
GEMINI_MODEL=gemini-3.5-flash-lite

# Crawl scheduling and Semantic cache
CRAWL_INTERVAL_MINUTES=60
SEMANTIC_CACHE_THRESHOLD=0.1
SEMANTIC_CACHE_TTL_SECONDS=86400